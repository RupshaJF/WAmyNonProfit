rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────
    //  ADMIN CHECK
    //  এখানে admin ইমেইল বসান — firestore.rules ও
    //  admin/js/admin-config.js — দুই জায়গায় একই থাকতে হবে
    // ─────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'imran.info.me@gmail.com'
        ];
    }

    // ─────────────────────────────────────────────────────────
    //  MEMBERS COLLECTION
    //  - registration.js  → নতুন আবেদন create করে
    //  - login.js         → member_id দিয়ে read, stored_password update
    //  - verify.html      → member_id দিয়ে read
    //  - admin panel      → সব কিছু (read/update/delete)
    // ─────────────────────────────────────────────────────────
    match /members/{memberId} {

      // যে কেউ read করতে পারবে (verify + login উভয়েই দরকার)
      allow read: if true;

      // নতুন আবেদন — required fields থাকতে হবে, status অবশ্যই 'pending'
      allow create: if
        request.resource.data.full_name is string &&
        request.resource.data.full_name.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.member_id is string &&
        request.resource.data.member_id.size() > 0 &&
        request.resource.data.status == 'pending';

      // UPDATE দুই ধরনের ক্ষেত্রে allowed:
      //  ① Admin panel — সব ফিল্ড পরিবর্তন করতে পারবে
      //  ② Login system (unauthenticated) — শুধুমাত্র stored_password
      //     ফিল্ড আপডেট করতে পারবে (password reset flow)
      allow update: if isAdmin() ||
        (
          // কেউ লগড-ইন না হলেও শুধু stored_password set করতে পারবে
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['stored_password']) &&
          request.resource.data.stored_password is string &&
          request.resource.data.stored_password.size() >= 8 &&
          request.resource.data.stored_password.size() <= 64
        );

      // delete শুধু admin
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    //  TEAM MEMBERS (#/member পেজ)
    // ─────────────────────────────────────────────────────────
    match /team_members/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    //  DONORS (#/donors পেজ)
    // ─────────────────────────────────────────────────────────
    match /donors/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    //  NOTICES / ঘোষণা (সদস্য ড্যাশবোর্ডে দেখানো হয়)
    //  - সবাই read করতে পারবে (লগইন করা সদস্য দেখবে)
    //  - শুধু admin panel থেকে যোগ/এডিট/ডিলিট করা যাবে
    // ─────────────────────────────────────────────────────────
    match /notices/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    //  EVENTS / আসন্ন ইভেন্ট (সদস্য ড্যাশবোর্ডে দেখানো হয়)
    // ─────────────────────────────────────────────────────────
    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    //  DEFAULT — অন্য সব collection বন্ধ
    // ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
