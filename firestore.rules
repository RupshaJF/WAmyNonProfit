rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  RJF — Firestore Rules: ধাপ ১ (ট্রানজিশন) — এখনকার কোডও চলবে, নতুন কোডও চলবে
//
//  এটা পুরনো rules-এর হুবহু কপি + নতুন দুটো কালেকশন (`member_emails`, `public_members`)।
//  পুরনো লগইন/verify/registration আগের মতোই কাজ করবে; নতুন কোড ডিপ্লয় ও ডেটা মাইগ্রেশন
//  শেষ হওয়া পর্যন্ত এটা ব্যবহার করুন। তারপর ধাপ ৫-এ চূড়ান্ত `firestore.rules` পাবলিশ করুন।
//
//  ⚠️ এই ফাইলে এখনো পুরনো দুর্বলতা (members সবার পড়া/পাসওয়ার্ড বদলানো) আছে — এটা শুধু
//     সাময়িক সেতু। রোলআউট শেষে অবশ্যই চূড়ান্ত ফাইল দিন।
// ═══════════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────
    //  ADMIN CHECK
    //  এখানে admin ইমেইল বসান — firestore.rules ও
    //  admin/js/admin-config.js — দুই জায়গায় একই থাকতে হবে
    // ─────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'imran.info.me@gmail.com'
        ];
    }

    // ─────────────────────────────────────────────────────────
    //  MEMBERS COLLECTION
    //  - registration.js  → নতুন আবেদন create করে
    //  - login.js         → member_id দিয়ে read, stored_password update
    //  - verify.html      → member_id দিয়ে read
    //  - admin panel      → সব কিছু (read/update/delete)
    // ─────────────────────────────────────────────────────────
    match /members/{memberId} {

      // যে কেউ read করতে পারবে (verify + login উভয়েই দরকার)
      allow read: if true;

      // নতুন আবেদন — required fields থাকতে হবে, status অবশ্যই 'pending'
      allow create: if
        request.resource.data.full_name is string &&
        request.resource.data.full_name.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.member_id is string &&
        request.resource.data.member_id.size() > 0 &&
        request.resource.data.status == 'pending';

      // UPDATE দুই ধরনের ক্ষেত্রে allowed:
      //  ① Admin panel — সব ফিল্ড পরিবর্তন করতে পারবে
      //  ② Login system (unauthenticated) — শুধুমাত্র stored_password
      //     ফিল্ড আপডেট করতে পারবে (password reset flow)
      allow update: if isAdmin() ||
        (
          // কেউ লগড-ইন না হলেও শুধু stored_password set করতে পারবে
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['stored_password']) &&
          request.resource.data.stored_password is string &&
          request.resource.data.stored_password.size() >= 8 &&
          request.resource.data.stored_password.size() <= 64
        );

      // delete শুধু admin
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    //  TEAM MEMBERS (#/member পেজ)
    // ─────────────────────────────────────────────────────────
    match /team_members/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    //  DONORS (#/donors পেজ)
    // ─────────────────────────────────────────────────────────
    match /donors/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    //  NOTICES / ঘোষণা (সদস্য ড্যাশবোর্ডে দেখানো হয়)
    //  - সবাই read করতে পারবে (লগইন করা সদস্য দেখবে)
    //  - শুধু admin panel থেকে যোগ/এডিট/ডিলিট করা যাবে
    // ─────────────────────────────────────────────────────────
    match /notices/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    //  EVENTS / আসন্ন ইভেন্ট (সদস্য ড্যাশবোর্ডে দেখানো হয়)
    // ─────────────────────────────────────────────────────────
    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    //  নতুন (ধাপ ১): হেল্পার + member_emails + public_members
    // ─────────────────────────────────────────────────────────
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') != '';
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // ইমেইল ইনডেক্স ডকুমেন্টের কী — ছোট হাতের, বৈধ ইমেইল আকার
    function isEmailKey(k) {
      return k is string
        && k.size() <= 254
        && k.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$');
    }

    function text(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    function indexPath(email) {
      return /databases/$(database)/documents/member_emails/$(email);
    }


    // ───────────────────────────── MEMBER_EMAILS (ইনডেক্স) ─────────────────────────────
    //  ডকুমেন্ট আইডি = সদস্যের ছোট হাতের ইমেইল; ডেটা: { member_doc, status }
    //  কাজ: (১) একই ইমেইলে দুইবার আবেদন আটকানো (২) সদস্য নিজের ডকুমেন্ট খুঁজে পাওয়া
    //       (৩) নোটিশ/ইভেন্ট দেখার অনুমতি যাচাই
    function isValidIndexCreate(k) {
      let d = request.resource.data;
      return isEmailKey(k)
        && d.keys().hasOnly(['member_doc', 'status'])
        && d.keys().hasAll(['member_doc', 'status'])
        && d.status == 'pending'
        && d.member_doc is string && d.member_doc.size() == 20
        && existsAfter(/databases/$(database)/documents/members/$(d.member_doc))
        && getAfter(/databases/$(database)/documents/members/$(d.member_doc)).data.email == k;
    }

    match /member_emails/{emailKey} {
      allow get: if isAdmin()
        || (isVerifiedUser() && emailKey == myEmail());
      allow list: if isAdmin();
      allow create: if isAdmin() || isValidIndexCreate(emailKey);
      allow update, delete: if isAdmin();
    }

    // ───────────────────────────── PUBLIC_MEMBERS (verify.html) ─────────────────────────────
    //  শুধু অনুমোদিত সদস্যের পাবলিক তথ্য (অ্যাডমিন প্যানেল লেখে)। একটা করে ID দিয়ে পড়া যায়,
    //  কিন্তু তালিকা বা সার্চ করা যায় না। মোবাইল নম্বর শুধু মাস্ক করা (017*****678) আকারে।
    function isValidPublicDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'member_id', 'status', 'full_name', 'occupation', 'membership_type',
               'blood_group', 'gender', 'mobile_number', 'permanent_address', 'photo_url'
             ])
        && d.keys().hasAll(['member_id', 'status'])
        && d.status in ['approved', 'blocked']
        && text(d.member_id, 3, 40)
        && text(d.get('full_name', ''), 0, 100)
        && text(d.get('occupation', ''), 0, 100)
        && text(d.get('membership_type', ''), 0, 60)
        && text(d.get('blood_group', ''), 0, 4)
        && text(d.get('gender', ''), 0, 20)
        && text(d.get('permanent_address', ''), 0, 300)
        && (d.get('mobile_number', '') == '' || d.mobile_number.matches('^[0-9]{3}\\*{5}[0-9]{3}$'))
        && (d.get('photo_url', '') == '' || (text(d.photo_url, 1, 600) && d.photo_url.matches('^(https://|/).*')));
    }

    match /public_members/{publicId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidPublicDoc();
      allow delete: if isAdmin();
    }


    // ─────────────────────────────────────────────────────────
    //  DEFAULT — অন্য সব collection বন্ধ
    // ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
